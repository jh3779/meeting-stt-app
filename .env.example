# 백엔드(app/)에서 사용 — 실제 값은 .env로 복사해서 채운다: cp .env.example .env
OPENAI_API_KEY=

# Firestore 서비스 계정 키는 이 폴더에 serviceAccountKey.json으로 둔다(별도 파일, .gitignore 처리됨)

# 로컬 Firestore 에뮬레이터를 쓸 때만 주석 해제 (docker compose up -d 로 먼저 실행)
# — serviceAccountKey.json 없이도 DB 저장/조회 로직을 테스트할 수 있음(OpenAI 토큰 절약 목적)
# FIRESTORE_EMULATOR_HOST=localhost:8080
