# Streamlit Cloud 배포 시 앱 설정 → Secrets에 이 내용을 채워 넣을 것.
# 로컬에서 쓰려면 이 파일을 .streamlit/secrets.toml로 복사해서 채운다
# (secrets.toml 자체는 .gitignore에 있어 커밋되지 않음).

OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-4o-mini"

# 선택: LangSmith 트레이싱을 쓰려면
# LANGCHAIN_TRACING_V2 = "true"
# LANGCHAIN_API_KEY = "lsv2_..."
# LANGCHAIN_PROJECT = "lgcns-agentic-ai"

# serviceAccountKey.json 내용을 그대로 옮겨 적을 것 (키/값 그대로, private_key의
# 줄바꿈은 \n 그대로 두면 TOML이 알아서 처리함)
[firestore_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
